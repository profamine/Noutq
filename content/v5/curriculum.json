    "categories": [
      {
        "id": "A",
        "titleAr": "أصوات لها مقابل أرمني قريب",
        "sounds": [
          "ا",
          "ب",
          "ج",
          "ر",
          "ش",
          "ف",
          "ل",
          "م",
          "ن",
          "خ",
          "غ"
        ],
        "noteAr": "ابدأ بالمقابل الأرمني القريب ثم طابقه بالنموذج العربي. خ تقارب խ، وغ تقارب ղ، وج تقارب ջ، لكن الصوت العربي يبقى المرجع.",
        "noteHy": "Սկսիր մոտ հայերեն հնչյունից, ապա համեմատիր արաբերեն նմուշի հետ։ خ-ը մոտ է խ-ին, غ-ը՝ ղ-ին, իսկ ج-ը՝ ջ-ին։"
      },
      {
        "id": "B",
        "titleAr": "أصوات لها نقطة انطلاق قريبة لكنها تحتاج تمييزًا",
        "sounds": [
          "ه / ح",
          "س / ص",
          "ت / ط",
          "د / ض",
          "ز / ظ",
          "ك / ق",
          "و / ي"
        ],
        "noteAr": "درّب كل زوج ببطء ثم في مقاطع قصيرة، ولا تستبدل الصوت المفخم بنظيره غير المفخم. و وي قد تكونان صامتين أو حرفَي مد بحسب السياق.",
        "noteHy": "Յուրաքանչյուր զույգ վարժիր դանդաղ, ապա կարճ վանկերով։ Մի՛ փոխարինիր ընդգծված հնչյունը նրա սովորական զույգով։ و և ي-ի գործառույթը կախված է համատեքստից։"
      },
      {
        "id": "C",
        "titleAr": "أصوات لا مقابل أرمني مباشرًا مفيدًا لها",
        "sounds": [
          "ث",
          "ذ",
          "ع",
          "ء"
        ],
        "noteAr": "استمع إلى النموذج، راقب موضع اللسان والحلق، ثم سجّل نفسك. لا تستبدل الصوت بحرف أرمني.",
        "noteHy": "Լսիր նմուշը, հետևիր լեզվի և կոկորդի դիրքին, ապա ձայնագրիր քեզ։ Հնչյունը մի փոխարինիր հայերեն տառով։"
      }
    ],
