GEMINI_API_KEY=

# URL publique du serveur API (déploiement Vercel), utilisée uniquement
# pour le build de l'APK Capacitor. Laisser vide pour le web (dev et prod).
VITE_API_BASE_URL=

# عنوان HTTPS العام المعتمد لمسارات الصوت وQR. اتركه فارغًا لتعطيل QR.
# مثال محلي فقط — لا تثبّت هذا المثال في الإنتاج، استعمل نطاقك الحقيقي:
# NOUTQ_PUBLIC_BASE_URL=https://your-real-domain.example
NOUTQ_PUBLIC_BASE_URL=

# فعّل فقط إذا كانت نسخة صوت منشورة فعليًا وقابلة للتشغيل من المتصفح.
# الصوت داخل التطبيق محلي دائمًا (Local-first) بغضّ النظر عن هذا الإعداد.
NOUTQ_WEB_AUDIO_ENABLED=false
