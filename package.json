{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "generate:v5-audio": "tsx scripts/generateV5AudioManifest.ts && tsx scripts/generateRecordingSheet.ts",
    "validate:v5": "npm run generate:v5-audio && tsx scripts/validateV5.ts",
    "qr:audio:generate": "tsx scripts/generateAudioQr.ts",
    "qr:audio:validate": "tsx scripts/validateAudioQr.ts",
    "qr:audio:all": "npm run qr:audio:generate && npm run qr:audio:validate",
    "docs:v5:data": "tsx scripts/exportV5DocumentData.ts .tmp/v5-document-data.json",
    "docs:v5:qr": "npm run qr:audio:all && npm run docs:v5:data && python scripts/generate_v5_document.py --data .tmp/v5-document-data.json --output Noutq-contenu-pedagogique-v5-rc2.docx",
    "docs:v5:no-qr": "npm run docs:v5:data && python scripts/generate_v5_document.py --data .tmp/v5-document-data.json --output Noutq-contenu-pedagogique-v5-rc2.docx --no-qr",
    "start": "node dist/server.cjs",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
